{{!
    @template local_mohhierarchy/hierarchy_browser

    Read-only, paginated facility hierarchy.

    Example context (json):
    {
        "ownershipnotice": "Records are owned by sync.",
        "hasrows": true,
        "rows": [{
            "zonename": "Central",
            "zonelocalid": 1,
            "zoneexternalid": 10,
            "zonestate": "Active",
            "districtname": "Dedza",
            "districtlocalid": 2,
            "districtexternalid": 20,
            "districtstate": "Active",
            "facilityname": "Dedza Hospital",
            "facilitycode": "MC01",
            "facilitylocalid": 3,
            "facilityexternalid": 30,
            "facilitystate": "Active"
        }],
        "paging": ""
    }
}}
<div class="local-mohhierarchy-browser">
    <div class="alert alert-info" role="status">{{ownershipnotice}}</div>
    {{#hasrows}}
        <table class="generaltable">
            <caption class="sr-only">{{#str}} hierarchybrowser, local_mohhierarchy {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} zone, local_mohhierarchy {{/str}}</th>
                    <th scope="col">{{#str}} district, local_mohhierarchy {{/str}}</th>
                    <th scope="col">{{#str}} facility, local_mohhierarchy {{/str}}</th>
                    <th scope="col">{{#str}} facilitycode, local_mohhierarchy {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>
                            <strong>{{zonename}}</strong>
                            <div class="small text-muted">
                                {{#str}} localid, local_mohhierarchy {{/str}}: {{zonelocalid}};
                                {{#str}} externalid, local_mohhierarchy {{/str}}: {{zoneexternalid}}
                            </div>
                            <span class="{{^zoneactive}}text-danger{{/zoneactive}}">{{zonestate}}</span>
                        </td>
                        <td>
                            <span aria-hidden="true">└─</span> <strong>{{districtname}}</strong>
                            <div class="small text-muted">
                                {{#str}} localid, local_mohhierarchy {{/str}}: {{districtlocalid}};
                                {{#str}} externalid, local_mohhierarchy {{/str}}: {{districtexternalid}}
                            </div>
                            <span class="{{^districtactive}}text-danger{{/districtactive}}">{{districtstate}}</span>
                        </td>
                        <td>
                            <span aria-hidden="true">└─</span> {{facilityname}}
                            <div class="small text-muted">
                                {{#str}} localid, local_mohhierarchy {{/str}}: {{facilitylocalid}};
                                {{#str}} externalid, local_mohhierarchy {{/str}}: {{facilityexternalid}}
                            </div>
                            <span class="{{^facilityactive}}text-danger{{/facilityactive}}">{{facilitystate}}</span>
                        </td>
                        <td>{{facilitycode}}</td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
        {{{paging}}}
    {{/hasrows}}
    {{^hasrows}}
        <div class="alert alert-info" role="status">{{#str}} nohierarchyfound, local_mohhierarchy {{/str}}</div>
    {{/hasrows}}
</div>
