{{!
    @template local_mohhierarchy/assignment_manager

    Searchable user assignment table.

    Example context (json):
    {
        "hasrows": true,
        "rows": [{
            "fullname": "Pat Banda",
            "username": "pbanda",
            "email": "pat@example.org",
            "zonename": "Central",
            "districtname": "Dedza",
            "facilityname": "Dedza Hospital",
            "scope": "District",
            "canmanage": true,
            "editurl": "#"
        }],
        "paging": ""
    }
}}
<div class="local-mohhierarchy-assignments">
    {{#hasrows}}
        <table class="generaltable">
            <caption class="sr-only">{{#str}} assignmentadministration, local_mohhierarchy {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} user, core {{/str}}</th>
                    <th scope="col">{{#str}} zone, local_mohhierarchy {{/str}}</th>
                    <th scope="col">{{#str}} district, local_mohhierarchy {{/str}}</th>
                    <th scope="col">{{#str}} facility, local_mohhierarchy {{/str}}</th>
                    <th scope="col">{{#str}} scopelevel, local_mohhierarchy {{/str}}</th>
                    <th scope="col">{{#str}} actions, core {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>
                            <strong>{{fullname}}</strong>
                            <div class="small text-muted">{{username}} · {{email}}</div>
                        </td>
                        <td>{{zonename}}</td>
                        <td>{{districtname}}</td>
                        <td>
                            {{facilityname}}
                            {{#facilityinactive}}
                                <span class="badge badge-danger">{{#str}} stateinactive, local_mohhierarchy {{/str}}</span>
                            {{/facilityinactive}}
                        </td>
                        <td>
                            {{scope}}
                            {{#withdrawn}}
                                <span class="badge badge-secondary">{{#str}} assignmentwithdrawn, local_mohhierarchy {{/str}}</span>
                            {{/withdrawn}}
                        </td>
                        <td>
                            {{#canmanage}}
                                <a class="btn btn-secondary btn-sm" href="{{editurl}}">
                                    {{#str}} editassignment, local_mohhierarchy {{/str}}
                                </a>
                            {{/canmanage}}
                            {{^canmanage}}<span class="text-muted">—</span>{{/canmanage}}
                        </td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
        {{{paging}}}
    {{/hasrows}}
    {{^hasrows}}
        <div class="alert alert-info" role="status">{{emptymessage}}</div>
    {{/hasrows}}
</div>
