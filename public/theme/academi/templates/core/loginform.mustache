{{!
    @template core/loginform

    CPD login form override for the Academi theme.
}}

<div class="cpd-loginform">
    <h2 class="cpd-form-title">Welcome back</h2>
    <p class="cpd-form-intro">Log in to access your courses and certificates.</p>

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance">{{{maintenance}}}</div>
    {{/maintenance}}
    {{#error}}
        <div class="alert alert-danger" id="loginerrormessage" role="alert">
            {{#errortitle}}<strong class="d-block mb-1">{{errortitle}}</strong>{{/errortitle}}
            {{error}}
        </div>
    {{/error}}
    {{#info}}
        <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}

    {{#showloginform}}
        <form class="login-form" action="{{loginurl}}" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">

            <div class="cpd-form-group login-form-username">
                <label for="username">
                    {{^canloginbyemail}}{{#str}}username{{/str}}{{/canloginbyemail}}
                    {{#canloginbyemail}}{{#str}}usernameemail{{/str}}{{/canloginbyemail}}
                </label>
                <div class="cpd-control-wrap">
                    <i class="fa fa-user cpd-control-icon" aria-hidden="true"></i>
                    <input type="text" name="username" id="username" class="form-control cpd-input" value="{{username}}"
                        placeholder="{{^canloginbyemail}}{{#str}}enterusername{{/str}}{{/canloginbyemail}}{{#canloginbyemail}}{{#str}}loginenterusernameoremail{{/str}}{{/canloginbyemail}}"
                        autocomplete="username">
                </div>
            </div>

            <div class="cpd-form-group login-form-password">
                <label for="password">{{#str}}password{{/str}}</label>
                <div class="cpd-control-wrap">
                    <i class="fa fa-lock cpd-control-icon" aria-hidden="true"></i>
                    <input type="password" name="password" id="password" class="form-control cpd-input" value=""
                        placeholder="{{#str}}loginenterpassword{{/str}}" autocomplete="current-password">
                </div>
            </div>

            <div class="cpd-form-options">
                <label class="cpd-remember" for="rememberme">
                    <input type="checkbox" id="rememberme" name="rememberusername" value="1" {{#username}}checked{{/username}}>
                    <span>Remember me</span>
                </label>
                <a href="{{forgotpasswordurl}}">Lost password?</a>
            </div>

            {{#recaptcha}}
                <div class="login-form-recaptcha">{{{recaptcha}}}</div>
            {{/recaptcha}}

            <div class="login-form-submit">
                <button class="btn btn-primary cpd-login-button" type="submit" id="loginbtn">
                    <i class="fa fa-sign-in" aria-hidden="true"></i>{{#str}}login{{/str}}
                </button>
            </div>
        </form>
    {{/showloginform}}

    {{#hasauthinstructions}}
        <div class="cpd-login-extra d-lg-none">{{{instructions}}}</div>
    {{/hasauthinstructions}}
    {{^hasauthinstructions}}
        {{#cansignup}}
            <div class="cpd-login-extra text-center">
                {{#instructions}}<span>{{{instructions}}}</span>{{/instructions}}
                <a href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a>
            </div>
        {{/cansignup}}
        {{^cansignup}}
            {{#instructions}}<div class="cpd-login-extra">{{{instructions}}}</div>{{/instructions}}
        {{/cansignup}}
    {{/hasauthinstructions}}
    {{#hasauthinstructions}}
        {{#cansignup}}
            <div class="cpd-login-extra text-center"><a href="{{signupurl}}">{{#str}}loginstartsignup{{/str}}</a></div>
        {{/cansignup}}
    {{/hasauthinstructions}}

    {{#hasidentityproviders}}
        <div class="cpd-login-separator">{{#str}}loginseparatoror{{/str}}</div>
        <div class="login-identityproviders">
            {{#identityproviders}}
                <a class="btn login-identityprovider-btn" href="{{url}}">
                    {{#iconurl}}<img src="{{iconurl}}" alt="" width="24" height="24">{{/iconurl}}
                    {{#str}}loginwith, core, {{name}}{{/str}}
                </a>
            {{/identityproviders}}
        </div>
    {{/hasidentityproviders}}

    {{#canloginasguest}}
        <div class="cpd-login-separator">{{#str}}loginseparatoror{{/str}}</div>
        <form action="{{loginurl}}" method="post" id="guestlogin">
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <input type="hidden" name="username" value="guest">
            <input type="hidden" name="password" value="guest">
            <button class="btn login-identityprovider-btn" type="submit" id="loginguestbtn">
                <i class="fa fa-user" aria-hidden="true"></i>{{#str}}loginasguest{{/str}}
            </button>
        </form>
    {{/canloginasguest}}

    <div class="cpd-login-utility">
        {{#languagemenu}}
            <div class="login-languagemenu">{{>core/action_menu}}</div>
        {{/languagemenu}}
        <button type="button" class="btn btn-link cpd-cookies-button"
            data-modal="alert"
            data-modal-title-str='["cookiesenabled", "core"]'
            data-modal-content-str='["cookiesenabled_help_html", "core"]'>
            <i class="fa fa-shield" aria-hidden="true"></i>{{#str}}cookiesnotice{{/str}}
        </button>
    </div>
</div>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length === 0) {
                        userNameField.focus();
                    } else if (passwordField) {
                        passwordField.focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                if (errorMessage && usernameField) {
                    usernameField.focus();
                }
                if (errorMessage) {
                    errorMessageDiv.innerHTML += '&nbsp;';
                }
                if (infoMessage) {
                    infoMessageDiv.innerHTML += '&nbsp;';
                }
                pendingJS.resolve();
            }, 500);
        }
    });
    {{#togglepassword}}
        require(['core/togglesensitive'], function(ToggleSensitive) {
            ToggleSensitive.init('password', {{smallscreensonly}});
        });
    {{/togglepassword}}
    require(['core_form/submit'], function(Submit) {
        Submit.init('loginbtn');
        {{#canloginasguest}}Submit.init('loginguestbtn');{{/canloginasguest}}
    });
{{/js}}
